# Build with scripts/weasyprint as the context. The launcher handles this.
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node
FROM ubuntu:24.04
COPY --from=node /usr/local/ /usr/local/
ENV DEBIAN_FRONTEND=noninteractive LANG=en_US.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      make bash wget ca-certificates locales unzip \
      xmlto xsltproc libxml2-utils tidy \
      ruby ruby-dev build-essential pkg-config libxml2-dev libxslt1-dev zlib1g-dev \
      python3 python3-venv \
      libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
      fonts-dejavu-core fonts-linuxlibertine \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8
RUN gem install --no-document nokogiri:1.18.8 optimist:3.2.0 htmlentities:4.3.4 \
    && npm install -g regenerator@0.14.12
COPY requirements.txt /opt/cll-weasyprint/requirements.txt
RUN python3 -m venv /opt/cll-weasyprint/venv \
    && /opt/cll-weasyprint/venv/bin/pip install --no-cache-dir -r /opt/cll-weasyprint/requirements.txt
COPY package.json package-lock.json /opt/cll-mathjax/
RUN npm ci --prefix /opt/cll-mathjax --no-audit --no-fund
ENV CLL_WEASYPRINT_PYTHON=/opt/cll-weasyprint/venv/bin/python \
    CLL_MATHJAX_DIR=/opt/cll-mathjax \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /srv/cll
